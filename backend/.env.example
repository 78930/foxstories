# Fox Stories Backend - Environment Variables Template
# Copy this to .env and fill in your actual values
# ⚠️ IMPORTANT: Never commit .env to GitHub! It's in .gitignore for a reason.

# ========== SERVER CONFIGURATION ==========
PORT=5000
NODE_ENV=development

# ========== DATABASE ==========
# Local MongoDB: mongodb://localhost:27017/foxstories
# MongoDB Atlas: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/foxstories?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/foxstories

# ========== SECURITY ==========
# Generate with: npm run gen:secret
# This must be a secure random 32+ character string
# ALWAYS change before production deployment
JWT_SECRET=your_32_byte_hex_secret_here_CHANGE_THIS

# ========== CORS CONFIGURATION ==========
# Local development: http://localhost:3000
# Production: https://your-frontend.onrender.com
FRONTEND_URL=http://localhost:3000

# ========== OPTIONAL: ADMIN SETUP ==========
# Only used during initial deployment with seed:admin script
ADMIN_EMAIL=admin@foxstories.com
ADMIN_PASSWORD=Admin@123

